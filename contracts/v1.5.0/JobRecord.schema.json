{
  "$defs": {
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "NOT_CONFIGURED",
        "NOT_INSTALLED",
        "UNSUPPORTED",
        "INVALID_INPUT",
        "PATH_VIOLATION",
        "LICENSE_REQUIRED",
        "EXECUTION_FAILED",
        "MALFORMED_OUTPUT",
        "CANCELLED",
        "TIMED_OUT",
        "INTERRUPTED"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "JobRequest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.5.0",
          "default": "1.5.0",
          "title": "Schema Version",
          "type": "string"
        },
        "job_id": {
          "format": "uuid",
          "title": "Job Id",
          "type": "string"
        },
        "workspace_id": {
          "format": "uuid",
          "title": "Workspace Id",
          "type": "string"
        },
        "tool_id": {
          "minLength": 1,
          "title": "Tool Id",
          "type": "string"
        },
        "operation": {
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        },
        "input_paths": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Input Paths",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "timeout_s": {
          "default": 30,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Timeout S",
          "type": "number"
        },
        "provenance": {
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        }
      },
      "required": [
        "tool_id",
        "operation",
        "provenance"
      ],
      "title": "JobRequest",
      "type": "object"
    },
    "JobResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.5.0",
          "default": "1.5.0",
          "title": "Schema Version",
          "type": "string"
        },
        "job_id": {
          "format": "uuid",
          "title": "Job Id",
          "type": "string"
        },
        "tool_id": {
          "title": "Tool Id",
          "type": "string"
        },
        "tool_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        },
        "status": {
          "$ref": "#/$defs/JobStatus"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "ended_at": {
          "format": "date-time",
          "title": "Ended At",
          "type": "string"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "outputs": {
          "items": {
            "type": "string"
          },
          "title": "Outputs",
          "type": "array"
        },
        "evidence_paths": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Paths",
          "type": "array"
        }
      },
      "required": [
        "job_id",
        "tool_id",
        "status"
      ],
      "title": "JobResult",
      "type": "object"
    },
    "JobStatus": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED",
        "TIMED_OUT"
      ],
      "title": "JobStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "request": {
      "$ref": "#/$defs/JobRequest"
    },
    "status": {
      "$ref": "#/$defs/JobStatus",
      "default": "QUEUED"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "progress": {
      "default": 0,
      "maximum": 1,
      "minimum": 0,
      "title": "Progress",
      "type": "number"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/JobResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "retry_of": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retry Of"
    },
    "manifest_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manifest Path"
    }
  },
  "required": [
    "request"
  ],
  "title": "JobRecord",
  "type": "object"
}
