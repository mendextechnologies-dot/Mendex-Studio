{
  "$defs": {
    "Lifecycle": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "archived"
      ],
      "title": "Lifecycle",
      "type": "string"
    },
    "Specification": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.0",
          "pattern": "^1\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "vin_min_v": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vin Min V"
        },
        "vin_nom_v": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vin Nom V"
        },
        "vin_max_v": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vin Max V"
        },
        "vout_v": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vout V"
        },
        "iout_a": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Iout A"
        },
        "switching_frequency_hz": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Switching Frequency Hz"
        },
        "ambient_temperature_k": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ambient Temperature K"
        },
        "topology": {
          "default": "",
          "title": "Topology",
          "type": "string"
        },
        "isolation_requirement": {
          "default": "",
          "title": "Isolation Requirement",
          "type": "string"
        },
        "standards_profile": {
          "default": "UNASSIGNED",
          "title": "Standards Profile",
          "type": "string"
        },
        "source": {
          "default": "",
          "title": "Source",
          "type": "string"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        }
      },
      "title": "Specification",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "revision_id": {
      "format": "uuid",
      "title": "Revision Id",
      "type": "string"
    },
    "product_id": {
      "format": "uuid",
      "title": "Product Id",
      "type": "string"
    },
    "revision_label": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "title": "Revision Label",
      "type": "string"
    },
    "lifecycle_status": {
      "$ref": "#/$defs/Lifecycle",
      "default": "draft"
    },
    "specification": {
      "$ref": "#/$defs/Specification"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "product_id",
    "revision_label"
  ],
  "title": "Revision",
  "type": "object"
}
