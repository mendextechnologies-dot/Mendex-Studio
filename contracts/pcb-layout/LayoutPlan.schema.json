        "maxLength": 100,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 10000,
      "title": "Fixed References",
      "type": "array"
    }
  },
  "required": [
    "relative_path",
    "expected_context_sha256",
    "rationale"
