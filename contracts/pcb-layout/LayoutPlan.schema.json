          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "x_m": {
          "maximum": 10,
          "minimum": -10,
          "title": "X M",
          "type": "number"
        },
        "y_m": {
          "maximum": 10,
          "minimum": -10,
          "title": "Y M",
          "type": "number"
        }
      },
      "required": [
        "reference",
        "x_m",
        "y_m"
      ],
      "title": "PlacementMove",
      "type": "object"
    }
  },
  "additionalProperties": false,
