{
  "$defs": {
    "Specification": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.0",
          "pattern": "^1\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "vin_min_v": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vin Min V"
        },
        "vin_nom_v": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vin Nom V"
        },
        "vin_max_v": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vin Max V"
        },
        "vout_v": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vout V"
        },
        "iout_a": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Iout A"
        },
        "switching_frequency_hz": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Switching Frequency Hz"
        },
        "ambient_temperature_k": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ambient Temperature K"
        },
        "topology": {
          "default": "",
          "title": "Topology",
          "type": "string"
        },
        "isolation_requirement": {
          "default": "",
          "title": "Isolation Requirement",
          "type": "string"
        },
        "standards_profile": {
          "default": "UNASSIGNED",
          "title": "Standards Profile",
          "type": "string"
        },
        "source": {
          "default": "",
          "title": "Source",
          "type": "string"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        }
      },
      "title": "Specification",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "pattern": "^1\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "revision_id": {
      "format": "uuid",
      "title": "Revision Id",
      "type": "string"
    },
    "tool_id": {
      "title": "Tool Id",
      "type": "string"
    },
    "adapter_version": {
      "default": "0.1.0",
      "title": "Adapter Version",
      "type": "string"
    },
    "status": {
      "default": "not_supported",
      "pattern": "^(not_started|queued|running|succeeded|failed|not_supported)$",
      "title": "Status",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "input_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Hash"
    },
    "artifacts": {
      "items": {
        "type": "string"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "log_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Log Path"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "limitation": {
      "default": "Solver execution is unavailable; no simulation has been performed",
      "title": "Limitation",
      "type": "string"
    },
    "specification": {
      "anyOf": [
        {
          "$ref": "#/$defs/Specification"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tool_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Version"
    }
  },
  "required": [
    "revision_id",
    "tool_id"
  ],
  "title": "SimulationRun",
  "type": "object"
}
