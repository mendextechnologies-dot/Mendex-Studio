{
  "$defs": {
    "Requirement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "discipline": {
          "enum": [
            "electrical",
            "mechanical",
            "environmental",
            "safety",
            "performance",
            "standards"
          ],
          "title": "Discipline",
          "type": "string"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "source": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "acceptance_criterion": {
          "default": "",
          "maxLength": 4000,
          "title": "Acceptance Criterion",
          "type": "string"
        },
        "mandatory": {
          "default": true,
          "title": "Mandatory",
          "type": "boolean"
        },
        "specification_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Specification Field"
        },
        "target_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Value"
        },
        "unit": {
          "default": "",
          "maxLength": 100,
          "title": "Unit",
          "type": "string"
        },
        "assumptions": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Assumptions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "discipline",
        "description",
        "source"
      ],
      "title": "Requirement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "3.1.0",
      "default": "3.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "reason": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "revision_id": {
      "format": "uuid",
      "title": "Revision Id",
      "type": "string"
    },
    "stage_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Stage Id",
      "type": "string"
    },
    "expected_input_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Expected Input Hash",
      "type": "string"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Requirements",
      "type": "array"
    }
  },
  "required": [
    "source",
    "reason",
    "idempotency_key",
    "revision_id",
    "stage_id",
    "expected_input_hash",
    "requirements"
  ],
  "title": "RequirementsWrite",
  "type": "object"
}
