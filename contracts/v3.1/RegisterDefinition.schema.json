{
  "$defs": {
    "Criterion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "enum": [
            "project_context",
            "specification_fields",
            "validation_record",
            "human_review"
          ],
          "title": "Kind",
          "type": "string"
        },
        "fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Fields",
          "type": "array"
        },
        "check_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Check Id"
        },
        "evidence_kind": {
          "anyOf": [
            {
              "enum": [
                "MANUAL",
                "CALCULATED",
                "SIMULATED",
                "MEASURED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Kind"
        }
      },
      "required": [
        "id",
        "description",
        "kind"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "LifecycleDefinition": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "3.1.0",
          "default": "3.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "maxLength": 40,
          "minLength": 1,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        },
        "name": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/StageDefinition"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Stages",
          "type": "array"
        }
      },
      "required": [
        "id",
        "version",
        "name",
        "stages"
      ],
      "title": "LifecycleDefinition",
      "type": "object"
    },
    "StageDefinition": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "purpose": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "required_inputs": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Required Inputs",
          "type": "array"
        },
        "expected_outputs": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Expected Outputs",
          "type": "array"
        },
        "dependencies": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Dependencies",
          "type": "array"
        },
        "optional": {
          "default": false,
          "title": "Optional",
          "type": "boolean"
        },
        "review_required": {
          "default": true,
          "title": "Review Required",
          "type": "boolean"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Criteria",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "purpose",
        "criteria"
      ],
      "title": "StageDefinition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "3.1.0",
      "default": "3.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "definition": {
      "$ref": "#/$defs/LifecycleDefinition"
    },
    "source": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "definition",
    "source"
  ],
  "title": "RegisterDefinition",
  "type": "object"
}
