{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "3.1.0",
      "default": "3.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "reason": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "revision_id": {
      "format": "uuid",
      "title": "Revision Id",
      "type": "string"
    },
    "stage_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Stage Id",
      "type": "string"
    },
    "expected_input_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Expected Input Hash",
      "type": "string"
    },
    "calculation": {
      "enum": [
        "dowell",
        "losses",
        "steinmetz",
        "flyback"
      ],
      "title": "Calculation",
      "type": "string"
    },
    "parameters": {
      "additionalProperties": true,
      "title": "Parameters",
      "type": "object"
    },
    "assumptions": {
      "items": {
        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Assumptions",
      "type": "array"
    }
  },
  "required": [
    "source",
    "reason",
    "idempotency_key",
    "revision_id",
    "stage_id",
    "expected_input_hash",
    "calculation",
    "parameters",
    "assumptions"
  ],
  "title": "CalculationWrite",
  "type": "object"
}
