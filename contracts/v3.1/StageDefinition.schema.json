{
  "$defs": {
    "Criterion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "enum": [
            "project_context",
            "specification_fields",
            "validation_record",
            "human_review"
          ],
          "title": "Kind",
          "type": "string"
        },
        "fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Fields",
          "type": "array"
        },
        "check_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Check Id"
        },
        "evidence_kind": {
          "anyOf": [
            {
              "enum": [
                "MANUAL",
                "CALCULATED",
                "SIMULATED",
                "MEASURED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Kind"
        }
      },
      "required": [
        "id",
        "description",
        "kind"
      ],
      "title": "Criterion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "purpose": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Purpose",
      "type": "string"
    },
    "required_inputs": {
      "items": {
        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 50,
      "title": "Required Inputs",
      "type": "array"
    },
    "expected_outputs": {
      "items": {
        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 50,
      "title": "Expected Outputs",
      "type": "array"
    },
    "dependencies": {
      "items": {
        "maxLength": 80,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string"
      },
      "maxItems": 100,
      "title": "Dependencies",
      "type": "array"
    },
    "optional": {
      "default": false,
      "title": "Optional",
      "type": "boolean"
    },
    "review_required": {
      "default": true,
      "title": "Review Required",
      "type": "boolean"
    },
    "criteria": {
      "items": {
        "$ref": "#/$defs/Criterion"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Criteria",
      "type": "array"
    }
  },
  "required": [
    "id",
    "name",
    "purpose",
    "criteria"
  ],
  "title": "StageDefinition",
  "type": "object"
}
