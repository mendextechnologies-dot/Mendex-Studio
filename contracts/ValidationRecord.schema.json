{
  "$defs": {
    "ManualCheck": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Check Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ValidationStatus",
          "default": "not_evaluated"
        },
        "rule_version": {
          "default": "manual-1.0",
          "minLength": 1,
          "title": "Rule Version",
          "type": "string"
        },
        "reviewer": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Reviewer",
          "type": "string"
        },
        "notes": {
          "minLength": 1,
          "title": "Notes",
          "type": "string"
        },
        "evidence_kind": {
          "default": "MANUAL",
          "pattern": "^(MANUAL|CALCULATED|SIMULATED|MEASURED)$",
          "title": "Evidence Kind",
          "type": "string"
        },
        "measured_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measured Value"
        },
        "unit": {
          "default": "",
          "title": "Unit",
          "type": "string"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        }
      },
      "required": [
        "check_id",
        "reviewer",
        "notes"
      ],
      "title": "ManualCheck",
      "type": "object"
    },
    "Specification": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.0",
          "pattern": "^1\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "vin_min_v": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vin Min V"
        },
        "vin_nom_v": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vin Nom V"
        },
        "vin_max_v": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vin Max V"
        },
        "vout_v": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vout V"
        },
        "iout_a": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Iout A"
        },
        "switching_frequency_hz": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Switching Frequency Hz"
        },
        "ambient_temperature_k": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ambient Temperature K"
        },
        "topology": {
          "default": "",
          "title": "Topology",
          "type": "string"
        },
        "isolation_requirement": {
          "default": "",
          "title": "Isolation Requirement",
          "type": "string"
        },
        "standards_profile": {
          "default": "UNASSIGNED",
          "title": "Standards Profile",
          "type": "string"
        },
        "source": {
          "default": "",
          "title": "Source",
          "type": "string"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        }
      },
      "title": "Specification",
      "type": "object"
    },
    "ValidationStatus": {
      "enum": [
        "pass",
        "fail",
        "not_evaluated",
        "physical_verification_required"
      ],
      "title": "ValidationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "format": "uuid",
      "title": "Record Id",
      "type": "string"
    },
    "revision_id": {
      "format": "uuid",
      "title": "Revision Id",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "specification": {
      "$ref": "#/$defs/Specification"
    },
    "input_hash": {
      "title": "Input Hash",
      "type": "string"
    },
    "check": {
      "$ref": "#/$defs/ManualCheck"
    },
    "evidence_uri": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Uri"
    },
    "evidence_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Sha256"
    },
    "evidence_filename": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Filename"
    },
    "provenance": {
      "default": "Manually supplied evidence and values; not independently verified by Mendex",
      "title": "Provenance",
      "type": "string"
    }
  },
  "required": [
    "revision_id",
    "specification",
    "input_hash",
    "check"
  ],
  "title": "ValidationRecord",
  "type": "object"
}