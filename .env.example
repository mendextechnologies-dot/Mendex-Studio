# Mendex Engineering Studio - Environment Configuration
# Copy this file to .env and configure your API keys as needed.

# =============================================================================
# AI Copilot Provider Configuration
# =============================================================================
# Google Gemini API Key (e.g. AIzaSy...)
GEMINI_API_KEY=

# OpenAI API Key (e.g. sk-...)
OPENAI_API_KEY=

# Preferred AI Provider: "gemini", "openai", or "offline" (default local rule engine)
MENDEX_AI_PROVIDER=offline

# Default Model Selection:
# For Gemini: "gemini-2.0-flash", "gemini-1.5-pro"
# For OpenAI: "gpt-4o", "gpt-4o-mini"
MENDEX_AI_MODEL=gemini-2.0-flash

# Explicit Cloud Opt-In (true/false)
# Must be set to true before proprietary circuit specs are dispatched to external cloud APIs
MENDEX_CLOUD_OPT_IN=false
